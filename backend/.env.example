PORT=3001
CORS_ORIGIN=http://localhost:5173
CORS_METHOD=GET,POST,PUT,DELETE
DB_STORAGE=./data/library.sqlite3
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-admin-password
ADMIN_NAME=Admin
ADMIN_PHONE=0000000000

# Leave these three blank for local dev - images will save to the local
# uploads/ folder automatically. Fill them in (e.g. on Render) and image
# uploads switch to Cloudinary automatically, with no code changes needed.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
